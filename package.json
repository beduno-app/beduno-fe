{
  "name": "beduno-fe",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --fix",
    "typecheck": "vue-tsc --noEmit",
    "generate:api-types": "openapi-typescript openapi.yaml -o src/shared/types/api-schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:analyze": "ANALYZE=true vite build",
    "docker:build": "docker build -f ./Dockerfile . -t beduno/beduno-fe"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "jsqr": "^1.4.0",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.2.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.5.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.86.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
